{
  "name": "dori-mode-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dori": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check .",
    "knip": "knip",
    "lint:loc": "bun check-loc.ts",
    "lint:ratchet": "bun src/lint/ratchet.ts",
    "lint:ratchet:update": "bun src/lint/ratchet.ts --update",
    "ci": "bun run check && bun run typecheck && bun run knip && bun run lint:loc && bun run lint:ratchet && bun test"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.2",
    "knip": "^6.47.0",
    "oxc-parser": "0.159.0",
    "typescript": "^7.0.2"
  }
}
